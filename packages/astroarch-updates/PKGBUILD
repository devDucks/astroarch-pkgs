# Maintainer: Mattia Procopio (astro.matto) <matto.astro at gmail dot com>
pkgname=astroarch-updates
pkgver=0.1.0
pkgrel=1
pkgdesc="Runs and records the AstroArch migration scripts (called by update-astroarch)"
arch=(x86_64 aarch64)
url=https://github.com/devDucks/astroarch-updates
license=(MIT)
# rusqlite is built with its bundled SQLite: no sqlite at run time
depends=(
    gcc-libs
    glibc
    zsh
)
makedepends=(cargo git)
# No release tag yet: pinned to a commit of main. Switch to #tag=v${pkgver} once one exists
_commit=5a1b39e560e2f2cf54f13fd2b4bbce0c44e638ec
source=("git+https://github.com/devDucks/astroarch-updates.git#commit=${_commit}")
sha256sums=('SKIP')

prepare() {
    cd ${pkgname}
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd ${pkgname}
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd ${pkgname}
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen --release
}

package() {
    cd ${pkgname}
    install -Dm755 target/release/astroarch-updates -t ${pkgdir}/usr/bin/
    install -Dm644 LICENSE -t ${pkgdir}/usr/share/licenses/${pkgname}/
}
