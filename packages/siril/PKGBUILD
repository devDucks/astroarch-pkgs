pkgname=siril
pkgver=1.4.4
pkgrel=1
pkgdesc="An astronomical image processing software for Linux. (IRIS clone)"
arch=('aarch64' 'x86_64')
license=('GPL3')
depends=(cfitsio
         exiv2
         ffms2
         fftw
         gsl
         gtk3
         gtksourceview4
         gvfs
         json-glib
         lcms2
         libgit2
         libheif
         libjpeg-turbo
         libjxl
         libpng
         libraw
         libtiff
         libtiff
         libxisf
         opencv
         wcslib)
makedepends=(cmake
             meson
             ninja)
optdepends=('ffmpeg: For AVI export')
options=(!lto)

source=("https://free-astro.org/download/siril-${pkgver}.tar.bz2")
sha256sums=('b1682f2129d2e06b034445ed225766a06e38cfaa7451b92d606a3ee36eb077a4')
source=('meson.build')
sha256sums=('SKIP')

# To be removed in the next version with OpenCV 5 #####
prepare() {
cp meson.build $srcdir/$pkgname-$pkgver/meson.build
}
######

build() {
  cd "$srcdir/$pkgname-$pkgver/"
  meson setup --prefix /usr --buildtype release _build
  ninja -C _build
}

package() {
  cd "$srcdir/$pkgname-$pkgver/"
  meson install -C _build --destdir "$pkgdir"
}
