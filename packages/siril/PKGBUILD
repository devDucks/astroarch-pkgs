pkgname=siril
pkgver=1.4.5
pkgrel=1
pkgdesc="An astronomical image processing software for Linux. (IRIS clone)"
url="https://gitlab.com/free-astro/siril"
arch=('aarch64' 'x86_64')
license=('GPL3')
depends=(cfitsio
         exiv2
         ffms2
         fftw
         gsl
         gtk3
         gtksourceview4
         gvfs
         json-glib
         lcms2
         libgit2
         libheif
         libjpeg-turbo
         libjxl
         libpng
         libraw
         libtiff
         libtiff
         libxisf
         opencv
         wcslib)
makedepends=(cmake
             meson
             ninja)
optdepends=('ffmpeg: For AVI export')
options=(!lto)

### Restore the commented-out lines when OpenCV 5 is released in a higher version
#source=("https://free-astro.org/download/siril-${pkgver}.tar.bz2")
#sha256sums=('b1682f2129d2e06b034445ed225766a06e38cfaa7451b92d606a3ee36eb077a4')

### To be removed when OpenCV 5 is released in a higher version
source=("git+$url.git")
sha256sums=('SKIP')

prepare() {
  cd "$srcdir/$pkgname/"
  pkgver=1.4 ### Version 1.4 patch between versions 1.4.5 and 1.4.6
  git checkout $pkgver
}
###

build() {
  #cd "$srcdir/$pkgname-$pkgver/"
  cd "$srcdir/$pkgname/"
  meson setup --prefix /usr --buildtype release _build
  ninja -C _build
}

package() {
  #cd "$srcdir/$pkgname-$pkgver/"
  cd "$srcdir/$pkgname/"
  meson install -C _build --destdir "$pkgdir"
}
