# Maintainer: Mattia Procopio (astro.matto) <matto.astro at gmail dot com>
pkgname=phd2
pkgver=2.6.14
pkgrel=3
pkgdesc="OpenPHDGuiding"
arch=(x86_64 aarch64)
url="https://openphdguiding.org/"
license=('LGPL')
depends=(cfitsio
         curl
         hdf5
         libnova
         libtiff5
         vtk
         wxwidgets-common	 
         wxwidgets-gtk3)
makedepends=(cmake eigen opencv)
source=("https://github.com/OpenPHDGuiding/phd2/archive/refs/tags/v${pkgver}dev1.tar.gz")
sha256sums=('178351bfc0a5bfa9fa14202c495fb2c6ba3868b814353b26edaa6a929177701e')

prepare() {
  mkdir -p build
  cd build
  cmake -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DUSE_SYSTEM_LIBINDI=ON \
        -DUSE_SYSTEM_LIBUSB=ON \
        -DUSE_SYSTEM_GTEST=ON \
        -DEIGEN_SRC=/usr/include/eigen3 \
        ../phd2-${pkgver}dev1
}

build() {
  cd build
  make
}

package() {
  cd build
  make DESTDIR="$pkgdir" install
}

