# Maintainer: Mattia Procopio (astro.matto) <matto.astro at gmail dot com>
pkgname=phd2
pkgver=2.6.14
pkgrel=3
pkgdesc="OpenPHDGuiding"
arch=(x86_64 aarch64)
url="https://openphdguiding.org/"
license=('LGPL')
depends=(cfitsio
         curl
         hdf5
         libindi
         libnova
         libtiff
         vtk
         wxwidgets-common	 
         wxwidgets-gtk3)
makedepends=(cmake eigen)
source=("https://github.com/OpenPHDGuiding/phd2/archive/refs/tags/v${pkgver}dev1.tar.gz")
sha256sums=('178351bfc0a5bfa9fa14202c495fb2c6ba3868b814353b26edaa6a929177701e')
_extra_ver=dev1

prepare() {
  cd phd2-${pkgver}${_extra_ver}
  sed -i '/^#  define OPENCV_CAMERA$/d' src/cameras.h
  sed -i 's/^  find_package( OpenCV REQUIRED )$//; s/^  target_link_libraries(phd2 X11 ${OpenCV_LIBS})$/  target_link_libraries(phd2 X11)/' CMakeLists.txt
  cd ..
  mkdir -p build
  cd build
  cmake -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DUSE_SYSTEM_LIBINDI=ON \
        -DUSE_SYSTEM_LIBUSB=ON \
        -DUSE_SYSTEM_GTEST=ON \
        -DEIGEN_SRC=/usr/include/eigen3 \
        ../phd2-${pkgver}${_extra_ver}
}

build() {
  cd build
  make
}

package() {
  cd build
  make DESTDIR="$pkgdir" install
}

