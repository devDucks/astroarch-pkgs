# Maintainer: Mattia Procopio (astro.matto) <matto.astro at gmail dot com>
pkgname=astroarch-tools
pkgver=0.2.1
pkgrel=1
pkgdesc="AstroArch configuration tools: control center, backup, language, services and software installer"
arch=(x86_64 aarch64)
url=https://github.com/devDucks/astroarch-tools
license=(MIT GPL-3.0-or-later)
depends=(
    gcc-libs
    glibc
    qt6-base
    qt6-declarative
    # astroarch-backup
    btrfs-progs
    e2fsprogs
    polkit
    rsync
    udisks2
    util-linux
    # astroarch-locale-module
    systemd
    xkeyboard-config
    # astroarch-control-center: Kirigami, the Plasma style, KDE's country names, and the tools its probe
    # script reads the system with (nmcli, curl, sqlite3, smbclient, unix_chkpwd)
    kirigami
    qqc2-desktop-style
    ki18n
    kcmutils
    networkmanager
    curl
    sqlite
    smbclient
    pam
    # Data backup to a network folder (SMB), Image storage on drives (ACLs)
    cifs-utils
    acl
)
makedepends=(cargo qt6-tools)
optdepends=(
    'konsole: run update-astroarch, AstroMonitor and the services from the Control Center'
    'paru: install AUR packages from the software installer'
    'plasma-nm: network and hotspot settings opened by the Control Center'
    'plasma-workspace: user password settings opened by the Control Center'
    'plasma-desktop: date and time settings opened by the Control Center'
    'nfs-utils: data backup to an NFS network folder'
)

_assets=0.1.0   # Icons of the launchers (devDucks/astroarch-assets)
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz"
        "astroarch-assets-${_assets}.tar.gz::https://github.com/devDucks/astroarch-assets/archive/refs/tags/v${_assets}.tar.gz")
sha256sums=('607666ccdaa6f6f8235fbc30a01a0620e36e4ddf273522f8f389723a5a4f68aa'
            '47460cca6b215b5951005eba3b2de828f6e516a3bb4ccc59c388f98f1586a7c5')

prepare() {
    cd ${pkgname}-${pkgver}
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd ${pkgname}-${pkgver}
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release --workspace
}

check() {
    cd ${pkgname}-${pkgver}
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen --release --workspace
}

package() {
    cd ${pkgname}-${pkgver}

    local _app
    for _app in backup control-center locale-module software-installer sys-manager; do
        install -Dm755 target/release/astroarch-${_app} -t ${pkgdir}/usr/bin/
        install -Dm644 crates/astroarch-${_app}/org.astroarch.${_app}.desktop -t ${pkgdir}/usr/share/applications/
    done

    # Root helper of the backup app: fixed path, the polkit action refers to it
    install -Dm755 crates/astroarch-backup/scripts/astroarch-backup-helper.sh ${pkgdir}/usr/lib/astroarch-backup/astroarch-backup-helper
    install -Dm644 crates/astroarch-backup/scripts/org.astroarch.backup.policy -t ${pkgdir}/usr/share/polkit-1/actions/

    install -Dm644 crates/astroarch-software-installer/data/software.toml -t ${pkgdir}/usr/share/astroarch-software-installer/

    # Control Center: the script it reads the system with (fixed path, see src/setup_state.rs)
    install -Dm755 crates/astroarch-control-center/scripts/astroarch-control-center-probe.sh \
        ${pkgdir}/usr/lib/astroarch-control-center/astroarch-control-center-probe
    # Root helpers of the Image storage and Restore pages: fixed paths, their polkit
    # actions refer to them
    local _helper
    for _helper in storage restore; do
        install -Dm755 crates/astroarch-control-center/scripts/astroarch-${_helper}-helper.sh \
            ${pkgdir}/usr/lib/astroarch-control-center/astroarch-${_helper}-helper
        install -Dm644 crates/astroarch-control-center/scripts/org.astroarch.control-center.${_helper}.policy \
            -t ${pkgdir}/usr/share/polkit-1/actions/
    done
    # The "Data and settings" backup every 2 hours (a user timer, turned on from the page)
    install -Dm644 crates/astroarch-backup/systemd/astroarch-data-backup.{service,timer} \
        -t ${pkgdir}/usr/lib/systemd/user/

    # Icons of the launchers: full = scalable, sm_ = the small sizes
    local _icons="${srcdir}/astroarch-assets-${_assets}/AstroArch icons/control-center_icons" _tool _size
    for _tool in backup control-center locale-module software-installer sys-manager; do
        install -Dm644 "${_icons}/org.astroarch.${_tool}.svg" \
            ${pkgdir}/usr/share/icons/hicolor/scalable/apps/org.astroarch.${_tool}.svg
        for _size in 16 22 32; do
            install -Dm644 "${_icons}/org.astroarch.sm_${_tool}.svg" \
                ${pkgdir}/usr/share/icons/hicolor/${_size}x${_size}/apps/org.astroarch.${_tool}.svg
        done
    done

    install -Dm644 LICENSE -t ${pkgdir}/usr/share/licenses/${pkgname}/
}
