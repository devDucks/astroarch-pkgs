# Maintainer: Mattia Procopio (astro.matto)  <matto.astro at gmail dot com>
pkgname=rpicam-apps
pkgver=1.14.0
pkgrel=1
pkgdesc="This is a small suite of libcamera-based applications to drive the cameras on a Raspberry Pi platform."
arch=(aarch64)
url="https://github.com/raspberrypi/rpicam-apps"
license=(LGPLv2
         MIT
         GPLv3
         BSD2
         BSD3)
depends=(boost
	 boost-libs
	 libcamera-rpi
	 libexif
         libpisp
	 libpng
         python-piexif
         python-prctl)
makedepends=(meson
             python-jinja
             python-sphinx)
source=("https://github.com/raspberrypi/rpicam-apps/archive/refs/tags/v$pkgver.tar.gz"
        99-raspberrypi-dmaheap.rules)
sha256sums=('2bfad6db8754588fad418af771ee0a721f016bc02a0b037b4ea9c487786b4acd'
            '4fa512367f7602581703e977f4ca1eaed42199faf8ae15f1a7f47986daced955')

# paru python-pidng-git kmsxx-git
build() {
    cd $srcdir/rpicam-apps-$pkgver
    meson setup build -Dprefix=/usr -Dwerror=false
}

package() {
    cd $srcdir/rpicam-apps-$pkgver
    DESTDIR="$pkgdir" ninja -C build install
    install -Dm644 $srcdir/99-raspberrypi-dmaheap.rules -t $pkgdir/usr/lib/udev/rules.d/
}
